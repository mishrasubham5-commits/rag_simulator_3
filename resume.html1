    <script>
        // Tailwind script already included via CDN
        
        function downloadResume() {
            alert("In a real implementation, this would trigger a PDF generation or direct download.\n\nFor now, save this HTML file and print to PDF for a beautiful result!");
            // Advanced version could use jsPDF or html2canvas
        }
        
        // Smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                if (this.getAttribute('href') !== '#') {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth'
                        });
                    }
                }
            });
        });
        
        // Keyboard shortcut: Press 'R' for random neon flicker effect
        document.addEventListener('keydown', (e) => {
            if (e.key.toLowerCase() === 'r') {
                document.body.style.filter = 'hue-rotate(90deg) saturate(1.8)';
                setTimeout(() => {
                    document.body.style.filter = '';
                }, 800);
            }
        });
        
        console.log('%c🚀 Futuristic Resume Loaded Successfully', 'color: #00f5ff; font-family: monospace; font-size: 14px;');
    </script>
